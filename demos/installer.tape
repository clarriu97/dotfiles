# Installer walkthrough for the README (dry run: nothing changes): just demos
Output images/readme/installer.gif

Set Shell zsh
Set FontFamily "Hack Nerd Font"
Set FontSize 18
Set Width 1200
Set Height 720
Set Padding 24
Set Theme "TokyoNight"
Set TypingSpeed 70ms
Env HOME "/tmp/dotfiles-demo"
Env TERM_PROGRAM "vhs"

Hide
Type "source ~/.zshrc && cd ~/dotfiles && clear"
Enter
Sleep 1s
Show

Sleep 1s
Type "./install.sh --dry-run"
Sleep 500ms
Enter
Sleep 2.5s
Type "1 6"
Sleep 800ms
Enter
Sleep 1.5s
Type "y"
Sleep 300ms
Enter
Sleep 8s
