# Terminal tour for the README: just demos
Output images/readme/shell.gif

Set Shell zsh
Set FontFamily "Hack Nerd Font"
Set FontSize 18
Set Width 1200
Set Height 640
Set Padding 24
Set Theme "TokyoNight"
Set TypingSpeed 70ms
Env HOME "/tmp/dotfiles-demo"
Env TERM_PROGRAM "vhs"

Hide
Type "source ~/.zshrc && cd ~ && clear"
Enter
Sleep 1s
Show

Sleep 1s
Type "z weather"
Sleep 400ms
Enter
Sleep 1.5s
Type "l"
Sleep 400ms
Enter
Sleep 2.5s
Type "cat "
Ctrl+T
Sleep 1s
Type "main"
Sleep 1.5s
Enter
Sleep 600ms
Enter
Sleep 3.5s
Type "gs"
Sleep 400ms
Enter
Sleep 2.5s
Type "clear"
Enter
Type ".."
Sleep 400ms
Enter
Sleep 1.5s
Type "z notes"
Sleep 400ms
Enter
Sleep 1.5s
Type "cd -"
Sleep 400ms
Enter
Sleep 2.5s
